# ==============================================================================
# SISTEMA DE IDENTIFICAÇÃO E TARJAMENTO DE DADOS PESSOAIS — UFAM
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================

# --- Ambiente Geral ---
APP_NAME="Sistema de Identificação e Tarjamento de Dados Pessoais — UFAM"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Banco de Dados (PostgreSQL 16) ---
POSTGRES_USER="ufam_redactor"
POSTGRES_PASSWORD="ufam_secret_password_change_me"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_DB="ufam_redaction_db"
DATABASE_URL="postgresql+asyncpg://ufam_redactor:ufam_secret_password_change_me@postgres:5432/ufam_redaction_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Mensageria e Cache (Redis 7 / Celery) ---
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/1"

# --- Limites de Upload e Armazenamento Transitório (Zero-Retention Policy) ---
# Diretório montado em tmpfs/volume isolado para manipulação transitória de PDFs
TEMP_STORAGE_DIR="/tmp/ufam_redaction_spool"
# Tamanho máximo de upload permitido em bytes (Padrão: 52428800 = 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800
# Quantidade máxima de páginas por PDF
MAX_PDF_PAGES=500
# Tempo máximo de retenção de arquivos temporários em segundos (Padrão: 3600 = 1 hora)
TEMP_FILE_TTL_SECONDS=3600
# Intervalo da tarefa periódica de expurgo de arquivos expirados (segundos)
CLEANUP_INTERVAL_SECONDS=300

# --- Autenticação e Autorização (Keycloak OIDC / OAuth2 JWT) ---
OIDC_ENABLED=true
OIDC_ISSUER_URL="https://auth.ufam.edu.br/realms/ufam"
OIDC_CLIENT_ID="ufam-redaction-backend"
OIDC_AUDIENCE="ufam-redaction-backend"
OIDC_JWKS_URL="https://auth.ufam.edu.br/realms/ufam/protocol/openid-connect/certs"
OIDC_ALGORITHMS=["RS256"]
OIDC_JWKS_CACHE_TTL_SECONDS=3600
# Chave simétrica local (HS256) utilizada exclusivamente quando OIDC_ENABLED=false em desenvolvimento/testes locais
JWT_DEV_SECRET_KEY="dev_only_local_hs256_secret_change_in_prod_8f9a2b3c4d5e6f7a"
